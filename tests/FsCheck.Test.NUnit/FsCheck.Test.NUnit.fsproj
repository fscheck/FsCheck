<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>FsCheck.Test.NUnit</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <IsPackable>false</IsPackable>
        <EnableNUnitRunner>true</EnableNUnitRunner>
        <!-- NUnit3TestAdapter's props read EnableNUnitRunner before this file is evaluated, so set this explicitly. -->
        <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
        <!-- Microsoft.NET.Test.Sdk turns the apphost off; Visual Studio launches MTP test projects through the .exe. -->
        <UseAppHost>true</UseAppHost>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DefineConstants>DEBUG</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="PropertiesAttributeTests.fs" />
        <Compile Include="PropertyAttributeTests.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/FsCheck.NUnit/FsCheck.NUnit.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" VersionOverride="9.0.303" />
        <PackageReference Include="NUnit" />
        <PackageReference Include="NUnit3TestAdapter" />
        <PackageReference Include="Unquote" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
    </ItemGroup>
</Project>
