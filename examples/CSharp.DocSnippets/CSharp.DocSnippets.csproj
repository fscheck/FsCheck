<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>CSharp.DocSnippets</AssemblyName>
        <OutputType>Exe</OutputType>
        <!-- The xunit.core package marks the project as a test project; these are only doc snippets. -->
        <IsTestProject>false</IsTestProject>
    </PropertyGroup>
    <ItemGroup>
        <ProjectCapability Remove="TestContainer"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="FSharp.Core"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\FsCheck.Xunit\FsCheck.Xunit.fsproj"/>
        <ProjectReference Include="..\..\src\FsCheck\FsCheck.fsproj"/>
    </ItemGroup>
</Project>